{
  "name": "ledgerly-uk",
  "version": "0.1.0",
  "description": "Self-hosted UK accounting for sole traders & landlords: bank/document import, invoicing, recurring invoices, VAT and Self Assessment (SA100/SA102/SA103/SA105/SA108) worksheets.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "htm": "^3.1.1",
    "nodemailer": "^10.6.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.21.0",
    "preact": "^11.2.0",
    "read-excel-file": "^9.3.20"
  },
  "optionalDependencies": {
    "tesseract.js": "^7.0.0"
  }
}
